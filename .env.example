DIRECTOR_TOKEN=replace-with-a-long-random-secret
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
AI_DELAY_MS=600
AI_RESULT_HOLD_MS=60000
# Vercel: ใช้ HTTPS endpoint (แนะนำ)
KATAGO_API_URL=
KATAGO_API_KEY=
# Docker บน Render ตั้ง 3 path นี้ให้เอง; กรอกเฉพาะเมื่อรัน local/VPS แบบกำหนดเอง
KATAGO_BIN=
KATAGO_MODEL=
KATAGO_CONFIG=
# Remote GPU ใช้ค่ามาตรฐานด้านล่าง; Docker CPU บน Render Free กำหนดทับเป็น 32/1/120000
KATAGO_MAX_VISITS=1600
KATAGO_ROOT_SYMMETRIES=8
KATAGO_TIMEOUT_MS=20000
KATAGO_RETRY_COOLDOWN_MS=30000
GROQ_API_KEY=
OPENROUTER_API_KEY=
MC_LANG=th
